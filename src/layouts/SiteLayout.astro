---
import "../styles/global.css";

type Props = {
  title?: string;
  siteTitle?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogSiteName?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  noindex?: boolean;
};

const {
  title = "Anthony's PHYZ 1 | SRJC Physiology Study Help, Review Sessions, and Resources",
  siteTitle = "Physiology 1",
  description = "Anthony's PHYZ 1 for SRJC students. Find Physiology study resources, tutoring support, review sessions, practice materials, lab exam prep, and helpful links for succeeding in PHYZ 1.",
  keywords = "Anthony PHYZ 1, SRJC Physiology 1, Santa Rosa Junior College physiology tutoring, PHYZ 1 tutor, physiology study help, physiology lab exam prep, physiology review sessions",
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogSiteName = "Anthony's PHYZ 1",
  ogImage,
  ogImageAlt = "Anthony's PHYZ 1 website for SRJC students",
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  twitterImage = ogImage,
  noindex = false,
} = Astro.props;

type NavItem = {
  label: string;
  href: string;
  comingSoon?: boolean;
};

const navItems: NavItem[] = [
  { label: "Welcome", href: "/" },

  // Temporary student access page
  {
    label: "Colette Bizal PHYZ 1 Study Guides",
    href: "/srjc-phyz-1-colette-bizal-study-guides copy",
  },
  {
    label: "Colette Bizal PHYZ 1 Lecture Slides",
    href: "/srjc-phyz-1-colette-bizal-lecture-slides",
  },

  // Exam 1 Lecture Topics
  { label: "L1: Introduction (Coming Soon!)", comingSoon: true, href: "#" },
  {
    label: "L2: Chemistry & Proteins (Coming Soon!)",
    comingSoon: true,
    href: "#",
  },
  {
    label: "L3: Cells & Metabolism (Coming Soon!)",
    comingSoon: true,
    href: "#",
  },
  { label: "L4: Enzymes (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L5: Membranes (Coming Soon!)", comingSoon: true, href: "#" },

  // Exam 2 Lecture Topics
  { label: "L6: Nervous System (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L7: CNS (Coming Soon!)", comingSoon: true, href: "#" },
  {
    label: "L8: PNS: Sensory & Senses (Coming Soon!)",
    comingSoon: true,
    href: "#",
  },
  { label: "L9: PNS: Motor / ANS (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L10: Muscle (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L11: Endocrine (Coming Soon!)", comingSoon: true, href: "#" },

  // Exam 3 Lecture Topics
  {
    label: "L12: Cardiovascular System (Coming Soon!)",
    comingSoon: true,
    href: "#",
  },
  {
    label: "L13: Respiratory System (Coming Soon!)",
    comingSoon: true,
    href: "#",
  },
  { label: "L14: Urinary System (Coming Soon!)", comingSoon: true, href: "#" },

  // Exam 4 Lecture Topics
  { label: "L15: Digestion (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L16: Metabolism (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L17: Blood (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L18: Immune System (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "L19: Reproduction (Coming Soon!)", comingSoon: true, href: "#" },

  // Extra Resources
  { label: "Lab Exam Resources (Coming Soon!)", comingSoon: true, href: "#" },
  { label: "Anki Decks (Coming Soon!)", comingSoon: true, href: "#" },
];

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href !== "#" && (pathname === href || pathname.startsWith(`${href}/`));

const menuId = "mobile-nav";
const buttonId = "mobile-nav-button";
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth bg-stone-100">
  <head>
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="author" content="Anthony" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content={ogSiteName} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta
      name="twitter:card"
      content={twitterImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta
      name="google-site-verification"
      content="5RVMRA6MLIJw8F7Ca9P10n-3KSI4C6ceugzOqPLmqhk"
    />
  </head>

  <body class="min-h-full font-sans text-neutral-800 antialiased">
    <header class="border-b border-neutral-300 bg-white px-5 py-4">
      <div
        class="mx-auto flex w-full max-w-340 flex-col gap-4 md:flex-row md:items-center md:justify-between"
      >
        <div class="text-lg font-medium text-neutral-800">Anthony's PHYZ 1</div>
        <!-- 
        <div class="w-full md:max-w-90">
          <input
            type="text"
            placeholder="Search this site"
            aria-label="Search this site"
            class="w-full rounded-full border border-neutral-300 bg-white px-4 py-3 text-[0.95rem] text-neutral-800 outline-none transition focus:border-blue-500"
          />
        </div> -->
      </div>
    </header>

    <div
      class="mx-auto grid min-h-[calc(100vh-69px)] w-full max-w-340 grid-cols-1 md:grid-cols-[290px_minmax(0,1fr)]"
    >
      <aside
        class="border-b border-neutral-300 bg-neutral-50 md:border-r md:border-b-0"
      >
        <div
          class="flex items-center justify-between px-4 py-4 md:block md:py-0"
        >
          <div class="text-base font-semibold text-neutral-800 md:pb-3">
            {siteTitle}
          </div>

          <button
            id={buttonId}
            type="button"
            class="inline-flex items-center justify-center rounded-md border border-neutral-300 bg-white p-2 text-neutral-700 hover:bg-neutral-100 md:hidden"
            aria-expanded="false"
            aria-controls={menuId}
            aria-label="Open navigation menu"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>

        <nav
          id={menuId}
          class="hidden border-t border-neutral-300 md:block md:border-t-0"
        >
          <ul class="m-0 list-none p-0">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "block px-4 py-2.5 text-[0.94rem] no-underline transition hover:bg-neutral-100",
                      {
                        "border-r-0 bg-blue-50 font-semibold text-blue-800 md:border-r-[3px] md:border-blue-800":
                          isActive(item.href),
                        "text-neutral-400":
                          item.comingSoon && !isActive(item.href),
                        "text-neutral-800": !(
                          item.comingSoon && !isActive(item.href)
                        ),
                      },
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <slot />
    </div>

    <footer class="border-t border-neutral-300 bg-white px-5 py-6">
      <div
        class="mx-auto flex w-full max-w-340 flex-col gap-2 text-sm text-neutral-600"
      >
        <p class="font-medium text-neutral-800">Anthony's PHYZ 1</p>
        <p>Built as a study resource hub for SRJC Physiology students.</p>
        <p>
          This website is designed to help PHYZ 1 students review lecture
          concepts, prepare for lab exams, and practice physiology questions
          more actively.
        </p>
      </div>
    </footer>

    <script>
      const button = document.getElementById("mobile-nav-button");
      const menu = document.getElementById("mobile-nav");

      if (button && menu) {
        button.addEventListener("click", () => {
          const isOpen = !menu.classList.contains("hidden");
          menu.classList.toggle("hidden");
          button.setAttribute("aria-expanded", String(!isOpen));
        });
      }
    </script>

    <script
      data-goatcounter="https://anthony.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
